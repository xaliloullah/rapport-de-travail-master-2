<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="700" viewBox="0 0 1200 700"><rect width="1200" height="700" fill="#f8f9fa"/><text x="60" y="70" font-family="Arial" font-size="34" font-weight="bold">Lancement d’une instance Ubuntu EC2</text><rect x="60" y="120" width="1080" height="500" rx="20" fill="white" stroke="#6c757d" stroke-width="3"/><g font-family="Arial" font-size="22"><text x="100" y="170" font-weight="bold">1. AMI</text><text x="100" y="205">Ubuntu Server LTS</text><text x="100" y="275" font-weight="bold">2. Type d’instance</text><text x="100" y="310">t3.micro (exemple pédagogique)</text><text x="100" y="380" font-weight="bold">3. Réseau</text><text x="100" y="415">VPC → Subnet → Security Group</text><text x="100" y="485" font-weight="bold">4. Accès</text><text x="100" y="520">Key Pair + SSH TCP/22 limité</text><text x="650" y="170" font-weight="bold">5. Stockage</text><text x="650" y="205">Volume EBS racine</text><text x="650" y="275" font-weight="bold">6. Identité</text><text x="650" y="310">IAM Role / Instance Profile</text><text x="650" y="380" font-weight="bold">7. Validation</text><text x="650" y="415">Running + Status Checks</text><text x="650" y="485" font-weight="bold">8. Administration</text><text x="650" y="520">SSH puis AWS CLI</text></g><rect x="390" y="565" width="420" height="45" rx="10" fill="#e9ecef"/><text x="600" y="595" text-anchor="middle" font-family="Arial" font-size="21">Instance Ubuntu EC2 prête</text></svg>